{
  "info": {
    "name": "Enterprise Procurement System API",
    "description": "Complete API Collection for Enterprise Procurement System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"phone\": \"1234567890\",\n  \"address\": \"123 Main Street\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new USER account"
          },
          "response": []
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPass123\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Admin Office\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/admin/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "admin", "register"]
            },
            "description": "Register a new ADMIN account (only ADMIN can create another ADMIN)"
          },
          "response": []
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            },
            "description": "Login with email and password"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints for registration and login"
    },
    {
      "name": "Admin Dashboard",
      "item": [
        {
          "name": "Get Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN",
                "type": "text",
                "disabled": true
              }
            ],
            "url": {
              "raw": "http://localhost:8080/admin/dashboard",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "dashboard"]
            },
            "description": "Get admin dashboard information (ADMIN role required)"
          },
          "response": []
        }
      ],
      "description": "Admin-specific endpoints"
    },
    {
      "name": "User Dashboard",
      "item": [
        {
          "name": "Get User Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN",
                "type": "text",
                "disabled": true
              }
            ],
            "url": {
              "raw": "http://localhost:8080/user/dashboard",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["user", "dashboard"]
            },
            "description": "Get user dashboard information (USER role required)"
          },
          "response": []
        }
      ],
      "description": "User-specific endpoints"
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "user_token",
      "value": "",
      "type": "string",
      "description": "Store JWT token after login"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string",
      "description": "Store Admin JWT token after login"
    }
  ]
}
