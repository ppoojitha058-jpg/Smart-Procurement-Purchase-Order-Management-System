            "url": "{{base_url}}/api/finance/invoices/{{invoice_id}}/match"
          }
        },
        {
          "name": "Approve Invoice",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{finance_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"notes\": \"3-Way Match Verified by Finance\"\n}"
            },
            "url": "{{base_url}}/api/finance/invoices/{{invoice_id}}/status"
          }
        },
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{finance_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"transactionReference\": \"TXN-FIN-2026-9021\"\n}"
            },
            "url": "{{base_url}}/api/finance/invoices/{{invoice_id}}/payment"
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{finance_token}}"}],
            "url": "{{base_url}}/api/finance/payments"
          }
        }
      ]
