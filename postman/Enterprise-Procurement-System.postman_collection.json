              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{receiving_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{order_id}},\n  \"receivedBy\": \"Marcus Vance (Receiving Officer)\",\n  \"quantityReceived\": 2,\n  \"conditionStatus\": \"GOOD\",\n  \"notes\": \"All boxes intact. Quality check passed.\"\n}"
            },
            "url": "{{base_url}}/api/receiving/grn"
          }
        },
        {
          "name": "List All GRNs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{receiving_token}}"}],
            "url": "{{base_url}}/api/receiving/grn"
          }
