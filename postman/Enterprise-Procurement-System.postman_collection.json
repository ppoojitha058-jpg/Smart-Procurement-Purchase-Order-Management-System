    {
      "name": "4. Procurement (RFQ & PO)",
      "item": [
        {
          "name": "List Approved Requests",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{procurement_token}}"}],
            "url": "{{base_url}}/api/procurement/approved-requests"
          }
        },
        {
          "name": "Create RFQ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.rfqId) { pm.collectionVariables.set(\"rfq_id\", jsonData.rfqId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{procurement_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseRequestId\": {{request_id}},\n  \"title\": \"Enterprise Laptop Hardware RFQ\",\n  \"description\": \"Requesting best competitive pricing with 3-year warranty.\"\n}"
            },
            "url": "{{base_url}}/api/procurement/rfq"
          }
        },
        {
          "name": "List RFQs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{procurement_token}}"}],
            "url": "{{base_url}}/api/procurement/rfq"
          }
        },
        {
          "name": "View Quotes for RFQ",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{procurement_token}}"}],
            "url": "{{base_url}}/api/procurement/rfq/{{rfq_id}}/quotes"
          }
        },
        {
          "name": "Select Quote & Issue Purchase Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.orderId) { pm.collectionVariables.set(\"order_id\", jsonData.orderId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{procurement_token}}"}],
            "url": "{{base_url}}/api/procurement/rfq/{{rfq_id}}/select-quote/{{quote_id}}"
          }
        },
        {
          "name": "List Purchase Orders",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{procurement_token}}"}],
            "url": "{{base_url}}/api/procurement/orders"
          }
        }
      ]
    },
    {
      "name": "5. Supplier Portal",
      "item": [
        {
