              {"key": "Authorization", "value": "Bearer {{manager_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Approved for departmental operations upgrade.\"\n}"
            },
            "url": "{{base_url}}/api/manager/requests/{{request_id}}/approve"
          }
        },
        {
          "name": "Download Department Requests CSV",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{manager_token}}"}],
            "url": "{{base_url}}/api/reports/csv/department-requests?departmentId=1"
          }
        }
      ]
