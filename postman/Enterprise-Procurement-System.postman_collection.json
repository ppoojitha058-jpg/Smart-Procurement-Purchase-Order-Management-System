    {
      "name": "2. Employee Requisitions",
      "item": [
        {
          "name": "Get Catalog Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/products"
          }
        },
        {
          "name": "Create Purchase Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Created successfully\", function () { pm.response.to.have.status(201); });",
                  "if(jsonData.data && jsonData.data.requestId) { pm.collectionVariables.set(\"request_id\", jsonData.data.requestId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{employee_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"productId\": 1,\n  \"departmentId\": 1,\n  \"quantity\": 2\n}"
            },
            "url": "{{base_url}}/api/purchase-requests"
          }
        },
        {
          "name": "Get My Purchase Requests",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{employee_token}}"}],
            "url": "{{base_url}}/api/users/my-requests"
          }
        },
        {
          "name": "Download My Requests CSV",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{employee_token}}"}],
            "url": "{{base_url}}/api/reports/csv/my-requests?email=employee@eps.com"
          }
        }
      ]
    },
    {
