    {
      "name": "9. Security Negative Tests",
      "item": [
        {
          "name": "Employee Access Admin API (Expect 401/403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Access Denied (401 or 403)\", function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{employee_token}}"}],
            "url": "{{base_url}}/api/admin/users"
          }
        }
      ]
    }
