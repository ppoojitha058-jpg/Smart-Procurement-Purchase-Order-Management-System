            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": 1,\n  \"quotedPrice\": 2400.00,\n  \"deliveryDays\": 3,\n  \"comments\": \"Fast courier delivery with premium support\"\n}"
            },
            "url": "{{base_url}}/api/supplier/rfq/{{rfq_id}}/quote"
          }
        },
        {
          "name": "Supplier Accept PO",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{supplier_token}}"}],
            "url": "{{base_url}}/api/supplier/orders/{{order_id}}/accept"
          }
        },
        {
          "name": "Supplier Dispatch & Update Shipment",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{supplier_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"TRK-FEDEX-998822\",\n  \"shipmentDetails\": \"Shipped via FedEx Priority. ETA: Tomorrow.\"\n}"
            },
            "url": "{{base_url}}/api/supplier/orders/{{order_id}}/shipment"
          }
        },
        {
          "name": "Supplier Submit Invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.invoiceId) { pm.collectionVariables.set(\"invoice_id\", jsonData.invoiceId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{supplier_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceNumber\": \"INV-EXP-2026-009\",\n  \"amount\": 2400.00,\n  \"notes\": \"Standard 30 days payment terms\"\n}"
            },
            "url": "{{base_url}}/api/supplier/orders/{{order_id}}/invoice"
          }
        }
      ]
