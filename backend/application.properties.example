# =============================================================================
# Enterprise Procurement System — Application Configuration Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to: src/main/resources/application.properties
#   2. Replace every <PLACEHOLDER> value below with your actual values
#   3. NEVER commit application.properties to version control (it is in .gitignore)
# =============================================================================

# Server Configuration
server.port=8080
server.servlet.context-path=/

# Static Frontend Locations
spring.web.resources.static-locations=file:../frontend/,file:./frontend/,classpath:/static/

# Database Configuration
# Replace with your MySQL host, port, and database name
spring.datasource.url=jdbc:mysql://localhost:3306/enterprise_percussion?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=<YOUR_MYSQL_USERNAME>
spring.datasource.password=<YOUR_MYSQL_PASSWORD>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA/Hibernate Configuration
spring.jpa.database-platform=org.hibernate.dialect.MySQL8Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.use_sql_comments=true

# Logging Configuration
logging.level.root=INFO
logging.level.com.eps=DEBUG
logging.level.org.springframework.security=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# Application Configuration
spring.application.name=Enterprise Procurement System
app.version=1.0.0

# Security / JWT Configuration
# Replace with a strong random string (min 32 characters) for production
security.jwt.secret=<YOUR_STRONG_JWT_SECRET_MIN_32_CHARS>
security.jwt.expiration=86400000

# ModelMapper / Jackson
spring.jackson.serialization.indent-output=true

# File Upload Configuration
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Email (SMTP) Configuration
# For Gmail: use an App Password (not your regular Gmail password)
# See: https://support.google.com/accounts/answer/185833
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=<YOUR_GMAIL_ADDRESS>
spring.mail.password=<YOUR_GMAIL_APP_PASSWORD>
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
